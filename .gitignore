# Fotos der Jungs bleiben LOKAL.
# Ein GitHub-Pages-Repo ist oeffentlich - da gehoeren keine Bilder von echten
# Leuten rein. Aus den Fotos generierte Pixel-Koepfe kommen spaeter als
# anonymisierte Sprites in den Code, die Originale nie.
fotos/
*.jpg
*.jpeg
*.png
*.heic
!docs/*.png
!icons/*.png

# Kram
.DS_Store
Thumbs.db
desktop.ini
node_modules/
.vscode/

# fertige Pakete (tools/paket.py)
dist/

# Sicherung von tools/umbenennen.py (die Originale vor einer Umbenennung, fuer --zurueck)
.umbenennen-sicherung.json

# Kopie fuer die App-Huellen (tools/www.py) - wird bei jedem Bau neu erzeugt
www/

# Signier-Schluessel der App-Huellen: NIE ins Repo (das Repo ist oeffentlich)
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
keystore.properties

# Bau-Ordner der App-Huellen (werden von Android Studio/Xcode erzeugt)
android/app/build/
android/.gradle/
ios/App/build/
